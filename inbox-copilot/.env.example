# Anthropic API-Schluessel (Pflicht). Nie einchecken.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Model-IDs und Poll-Verhalten ueberschreiben (siehe inbox_copilot/config.py)
# TRIAGE_MODEL=claude-haiku-4-5-20251001
# DRAFTER_MODEL=claude-sonnet-5
# POLL_INTERVAL_S=60
# POLL_QUERY=in:inbox -category:promotions -category:social newer_than:2d
# POLL_MAX_MESSAGES=50

# Zeitlimits und Token-Budget der beiden Stufen. Die Standardwerte sind
# grosszuegig gesetzt; heraufsetzen, wenn Zeitueberschreitungen oder
# DRAFT_INVALID_JSON auftreten (abgeschnittenes JSON).
# TRIAGE_TIMEOUT_S=30.0
# DRAFTER_TIMEOUT_S=120.0
# DRAFTER_MAX_TOKENS=4000
