# ---- Required: vision analysis (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the styling analysis. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# ---- Image visualisation ----
# One of: placeholder | gemini | fal
#   placeholder - no external calls, shows an illustrative card (default; good for local dev)
#   gemini      - Gemini image editing (needs GEMINI_API_KEY)
#   fal         - FLUX.1 Kontext via fal.ai (needs FAL_KEY)
IMAGE_PROVIDER=placeholder

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

FAL_KEY=
FAL_KONTEXT_MODEL=fal-ai/flux-pro/kontext

# ---- Storage ----
# Where saved style profiles and anonymous feedback are appended (JSON lines).
# Photos are NEVER written here or anywhere else.
DATA_DIR=./data
